{
  "name": "tft-spicy-coach",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "collect:meta": "node scripts/buildMetaStats.js",
    "collect:ladder": "node scripts/buildMetaStatsLadder.js",
    "collect:decks": "node scripts/buildDeckComps.js",
    "meta:deltas": "node scripts/attachMetaDeltas.js",
    "eval:reports": "node scripts/evalReports.js",
    "eval:capture": "node scripts/captureEvalFixtures.js",
    "collect:contest": "node scripts/collectContestSamples.js",
    "collect:all": "node scripts/buildMetaStats.js && node scripts/collectContestSamples.js",
    "collect:check": "node scripts/collectContestSamples.js --check",
    "meta:check": "node scripts/checkMetaStats.js",
    "meta:summary": "node scripts/printMetaDeltas.js",
    "check:ops": "node scripts/checkOps.js",
    "collect:boards": "node scripts/collectLadderBoards.js",
    "collect:db": "node scripts/collectDb.js",
    "collect:db:dry": "node scripts/collectDb.js --dry-run",
    "collect:db:rollup": "node scripts/collectDb.js --rollup-only",
    "build:decks": "node scripts/buildDecksFromBoards.js --write",
    "build:decks:legacy": "node scripts/buildDeckCompsFromStats.js --write",
    "build:deck-preview": "node scripts/buildDecksFromBoards.js",
    "build:gamedata": "node scripts/buildGameData.js",
    "check:gamedata": "node scripts/buildGameData.js --check",
    "collect:patches": "node scripts/fetchPatchNotes.js",
    "collect:top": "node scripts/collectTopPlayers.js",
    "build:top": "node scripts/buildTopPlayerGuide.js",
    "icons": "node scripts/generateIcons.js",
    "decks:check": "node scripts/checkDecks.js",
    "test:augment": "node scripts/testAugmentAggregation.js",
    "test:axes": "node scripts/testAxes.js",
    "test:axes:update": "node scripts/testAxes.js --update",
    "test:collect": "node scripts/testCollect.js",
    "test:rollup": "node scripts/testRollup.js",
    "test:ops": "node scripts/testOps.js",
    "test:gate": "node scripts/testBotGate.js",
    "test:ai": "node scripts/testSemanticGrounding.js && node scripts/testComparisonFacts.js",
    "test:gamedata": "node scripts/testGameData.js",
    "inspect:match": "node scripts/inspectMatch.js",
    "rules:check": "node scripts/checkSceneRules.js",
    "facts:detect": "node scripts/detectGameFacts.js",
    "ci": "npm run lint && npm run typecheck && npm run meta:check && npm run test:axes && npm run test:collect && npm run test:rollup && npm run test:ops && npm run test:gate && npm run test:ai && npm run build",
    "seeds:pick": "node scripts/pickSeeds.js",
    "tune:contest": "node scripts/tuneContest.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
