# Riot API Configuration (https://developer.riotgames.com/)
RIOT_API_KEY=your_riot_api_key_here
RIOT_REGION=asia
RIOT_PLATFORM=kr
# Riot 호출 안전장치 (선택)
RIOT_TIMEOUT_MS=5000
RIOT_MAX_RETRIES=2
RIOT_MAX_CONCURRENCY=5
RIOT_MAX_RETRY_WAIT_MS=2000

# DeepSeek API Configuration (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 모델 ID (기본 deepseek-flash = DeepSeek-V4.1-Flash, 상위 모델은 deepseek-v4-pro)
DEEPSEEK_MODEL=deepseek-flash
# thinking 모드 (기본 disabled — 켜면 reasoning 토큰이 max_tokens 를 먼저 소모함)
DEEPSEEK_THINKING=disabled
# 전체 리포트 출력 상한 (기본 3400, 인트로 240 은 별도)
# DEEPSEEK_MAX_TOKENS=3400
# Pro 플랜 리포트: 같은 모델 + thinking (기본 enabled, disabled 면 무료와 동일)
# DEEPSEEK_PRO_THINKING=enabled
# Pro 리포트 출력 상한 (reasoning 토큰 포함, 기본 8000) · 타임아웃 (기본 55000ms)
# DEEPSEEK_PRO_MAX_TOKENS=8000
# LLM_PRO_TIMEOUT_MS=55000
# 리포트 제공자 강제: deepseek | gemini (비우면 DeepSeek → Gemini → 폴백)
# LLM_PROVIDER=
# 단가 보정 (USD / 1M tokens, 기본값은 deepseek-flash 피크 단가)
# DEEPSEEK_PRICE_INPUT_PER_M=0.3
# DEEPSEEK_PRICE_CACHED_INPUT_PER_M=0.006
# DEEPSEEK_PRICE_OUTPUT_PER_M=1.2

# Google Gemini API Configuration (Optional Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=45000

# 분산 캐시 (선택) — Upstash Redis 또는 Vercel KV REST
# 미설정 시 인메모리 캐시만 사용합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
CACHE_L1_MAX_TTL_MS=300000
REDIS_TIMEOUT_MS=800

# 운영
LOG_LEVEL=info
# 설정 시 /api/health 접근에 토큰 필요 (x-health-token 또는 Authorization: Bearer)
HEALTH_TOKEN=
META_MEMO_TTL_MS=300000

# 일일 사용 쿼터 (IP 기준, 0 = 무제한)
QUOTA_SEARCH_PER_DAY=50
QUOTA_ANALYSIS_PER_DAY=3
QUOTA_OVERVIEW_PER_DAY=3

# 로그인 사용자 Pro 쿼터 (profiles.plan = 'pro')
QUOTA_SEARCH_PRO_PER_DAY=200
QUOTA_ANALYSIS_PRO_PER_DAY=10
QUOTA_OVERVIEW_PRO_PER_DAY=10

# 쿼터 면제 계정 (운영자·테스트용, 쉼표 구분). Supabase user id 또는 인증된 이메일.
# Discord 로그인은 이메일이 없을 수 있으니 user id(/api/me 의 user.id) 권장. LLM 일일 예산은 그대로 적용된다.
QUOTA_EXEMPT_USERS=
# 운영자 키 (16자 이상, 로그인 없이 쓰는 면제). /owner 에서 입력하면 그 브라우저에 1년짜리 면제 쿠키가 발급된다.
# 키를 바꾸면 기존 쿠키는 모두 무효. 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
QUOTA_EXEMPT_KEY=

# Supabase (선택: 계정/플랜/사용자 쿼터)
# 미설정 시 계정 기능만 비활성화되고 익명 쿼터로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM 일일 예산 상한(USD, 0 = 무제한). 제공자 콘솔 하드 리밋과 함께 설정 권장
LLM_DAILY_BUDGET_USD=3

# Cloudflare Turnstile (선택, 둘 다 설정해야 동작)
# https://dash.cloudflare.com/ > Turnstile 에서 사이트 추가 후 발급
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=true
TURNSTILE_TIMEOUT_MS=3000

# 공개 사이트 정보 (배포 시 필수)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_OPERATOR_NAME=TFT LAB 운영자


